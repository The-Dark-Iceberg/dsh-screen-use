{
  "name": "dsh-screen-use",
  "version": "0.1.0",
  "description": "Screen reading and shared-pointer desktop control for DeepSeek Harness, behind a floating panel with its own token and safety switches.",
  "type": "commonjs",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "src/",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.png",
    "README.md",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "screen-use",
    "computer-use",
    "screen-capture",
    "gui-automation"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
